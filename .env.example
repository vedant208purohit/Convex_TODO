# Convex Deployment URL for Master App (Control Plane)
NEXT_PUBLIC_CONVEX_URL=https://your-master-app-deployment.convex.cloud

# Convex Management API Key (Server-side only)
CONVEX_MANAGEMENT_API_KEY=convex_mgt_...

# Convex Team ID for project provisioning
CONVEX_TEAM_ID=team_...

# Path to Default App template directory (optional, defaults to ../Default app relative to Master app)
DEFAULT_APP_PATH=../Default app

# Default App Local URL for "Open Store POS" redirect
NEXT_PUBLIC_DEFAULT_APP_URL=http://localhost:3000

