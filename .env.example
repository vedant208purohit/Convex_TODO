# ============================================================
# pos-default — Store POS Application & Authoritative Backend
# Copy this file to .env.local for local development.
# In Vercel / CI, inject each variable before building.
# ============================================================

# ── Convex Cloud Deployment ──────────────────────────────────
# Convex target deployment identifier (dev:your-deployment or prod:your-deployment)
CONVEX_DEPLOYMENT=dev:gregarious-chicken-229

# Convex Cloud URL (used by the client app at runtime)
NEXT_PUBLIC_CONVEX_URL=https://gregarious-chicken-229.convex.cloud

# Convex HTTP Actions base URL
NEXT_PUBLIC_CONVEX_SITE_URL=https://gregarious-chicken-229.convex.site

# ── Clerk Authentication (Instance B: Store Staff) ───────────
# Publishable key — safe to expose in browser (baked in at build time)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test...

# Secret key — server-side only, NEVER expose to the browser
CLERK_SECRET_KEY=sk_test_...

# Clerk routing configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk JWT issuer domain (used by Convex to verify staff Clerk tokens)
CLERK_JWT_ISSUER_DOMAIN=https://modest-raptor-18.clerk.accounts.dev

# Key ID prefix validator for Clerk Instance B tokens (defaults to ins_)
# DEFAULT_CLERK_KID_PREFIX=ins_

# ── Master Bridge & Provisioning Integration ─────────────────
# Master Control Plane URL for store resolution bridge requests
MASTER_POS_URL=new-app.get-prest.com

# Bridge secret: shared HMAC secret for authenticating store resolution requests to pos-master
# Must match BRIDGE_SECRET configured in pos-master.
BRIDGE_SECRET=NEW

# Provisioning secret: used to verify staff synchronization mutations from pos-master
# Must match PROVISIONING_SECRET in pos-master.
PROVISIONING_SECRET=NEW

# ── Customer Front-End Base URL (For QR Code Generation) ─────
# Canonical base URL used by store QR code generator for table/store ordering
FRONT_END_URL=https..

# ── Google Maps JavaScript API ───────────────────────────────
# API key for store geofencing, address autocompletion, and map rendering
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=AIzaSy...

# ── Razorpay Payment Gateway (Marketplace & Wallet Top-up) ───
# Public Key ID for browser Razorpay modal popup
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Server Key ID and Secret for Orders API and HMAC signature verification
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret...
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret...

# Compatibility Aliases (supported by existing service layers):
RZ_KEY_ID=rzp_test_...
RZ_KEY_SECRET=your_razorpay_secret...

# ── ComBird DLT SMS Gateway ──────────────────────────────────
# ComBird SMS API key for OTP delivery
COMBIRD_API_KEY=your_combird_api_key_here

# ComBird DLT registered OTP template ID
COMBIRD_TEMPLATE_ID=1707178064151587006

# Optional salt for OTP SHA-256 hashing in Convex
OTP_SECRET=your_otp_salt_secret

# ── Cloudflare R2 Storage (Convex Environment Variables) ─────
# Configure these in Convex deployment dashboard or via `npx convex env set`
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=pos-assets-prod
# R2_PUBLIC_DOMAIN=https://assets.get-prest.com


