# ============================================================
# pos-default — Store POS Application
# Copy this file to .env.local for local development.
# In Jenkins/CI, inject each variable as a build environment
# variable BEFORE running `npm run build`.
# ============================================================

# ── Convex ──────────────────────────────────────────────────
# Convex deployment identifier (dev/prod)
CONVEX_DEPLOYMENT=dev:doting-flamingo-779

# Convex Cloud URL (used by the app at runtime)
NEXT_PUBLIC_CONVEX_URL=https://doting-flamingo-779.convex.cloud

# Convex HTTP Actions base URL
NEXT_PUBLIC_CONVEX_SITE_URL=https://doting-flamingo-779.convex.site

# ── Clerk Authentication ─────────────────────────────────────
# Publishable key — safe to expose in browser (baked in at build time)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_bW9kZXN0LXJhcHRvci0xOC5jbGVyay5hY2NvdW50cy5kZXYk

# Secret key — server-side only, NEVER expose to the browser
CLERK_SECRET_KEY=sk_test_X4GhHakkrUlf4wFwIFuKDxbIabgcPvb5q8ZtIGeStc

# CRITICAL: These tell Clerk WHERE your custom sign-in/sign-up pages live.
# Without these, Clerk falls back to its default hosted UI at accounts.clerk.com.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk JWT issuer domain (used by Convex to verify Clerk tokens)
CLERK_JWT_ISSUER_DOMAIN=https://modest-raptor-18.clerk.accounts.dev

# ── Master Bridge & Provisioning Integration ─────────────────
# Bridge secret: used to authenticate store resolution requests to pos-master
# Must match BRIDGE_SECRET in pos-master. Server-side only, NEVER expose to browser.
BRIDGE_SECRET=your-bridge-secret-key

# Provisioning secret: used to verify staff synchronization mutations from pos-master
# Must match PROVISIONING_SECRET in pos-master. Server-side only, NEVER expose to browser.
PROVISIONING_SECRET=defx-pos-provisioning-secret-dev

# Master Control Plane URL for store resolution bridge requests
MASTER_POS_URL=http://localhost:3001

# ── App URLs ─────────────────────────────────────────────────
# Public URL of this Default App (used for cross-app redirects from pos-master)
NEXT_PUBLIC_DEFAULT_APP_URL=http://localhost:3000

# ── Cloudflare R2 Storage (Backend Only - Convex Environment) ──
# Required credentials for S3-compatible R2 asset storage.
# Set these in the Convex deployment dashboard or via `npx convex env set <KEY> <VALUE>`
# NEVER expose R2 credentials to the browser or use NEXT_PUBLIC_* prefixes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: Custom domain or Cloudflare public CDN URL (if enabled for public asset delivery)
R2_PUBLIC_DOMAIN=


