# ============================================================
# pos-master — Admin Control Plane
# Copy this file to .env.local for local development.
# In Jenkins/CI, inject each variable as a build environment
# variable BEFORE running `npm run build`.
# ============================================================

# ── Convex ──────────────────────────────────────────────────
# Convex deployment identifier (dev/prod)
CONVEX_DEPLOYMENT=dev:your-master-deployment-name

# Convex Cloud URL (used by the app at runtime)
NEXT_PUBLIC_CONVEX_URL=https://your-master-app-deployment.convex.cloud

# Convex HTTP Actions base URL
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-master-app-deployment.convex.site

# Convex Management API Key (server-side only)
CONVEX_MANAGEMENT_API_KEY=convex_mgt_...

# Convex Management Token (server-side only)
CONVEX_MANAGEMENT_TOKEN=eyJ...

# Convex Team ID for project provisioning
CONVEX_TEAM_ID=team_...

# ── Clerk Authentication ─────────────────────────────────────
# Publishable key — safe to expose in browser (baked in at build time)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret key — server-side only, NEVER expose to the browser
CLERK_SECRET_KEY=sk_test_...

# CRITICAL: These tell Clerk WHERE your custom sign-in page lives.
# Without these, Clerk falls back to its default hosted UI at accounts.clerk.com.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# Clerk JWT issuer domain (used by Convex to verify Clerk tokens for this master app)
CLERK_JWT_ISSUER_DOMAIN=https://your-master-clerk-domain.clerk.accounts.dev

# Clerk JWT issuer domain for the Default App (pos-default) — used when verifying
# cross-app tokens from store POS instances
DEFAULT_CLERK_JWT_ISSUER_DOMAIN=https://your-default-clerk-domain.clerk.accounts.dev

# ── App URLs ─────────────────────────────────────────────────
# Public URL of the Default Store POS App (for "Open Store POS" links)
NEXT_PUBLIC_DEFAULT_APP_URL=http://localhost:3000

# Path to Default App template directory (used during provisioning)
DEFAULT_APP_PATH=../pos-default














